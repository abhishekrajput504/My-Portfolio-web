# Copy to .env and fill in before running `docker compose up --build`.

# --- Backend: SMTP (used by the contact form) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username@gmail.com
SMTP_PASSWORD=your-smtp-app-password
CONTACT_RECIPIENT_EMAIL=rupesh.ar33@gmail.com

# --- Backend: CORS ---
# Must match the origin the frontend is actually served from.
CORS_ALLOWED_ORIGIN=http://localhost

# --- Frontend build arg ---
# Baked into the JS bundle at build time (Vite), not read at container runtime.
VITE_API_BASE_URL=http://localhost:8080
